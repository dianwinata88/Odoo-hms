<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="module_category_hms" model="ir.module.category">
            <field name="name">Hospital</field>
            <field name="description">Hospital Management System access levels</field>
            <field name="sequence">30</field>
        </record>

        <record id="group_hms_receptionist" model="res.groups">
            <field name="name">Receptionist</field>
            <field name="category_id" ref="hms.module_category_hms"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_hms_practitioner" model="res.groups">
            <field name="name">Practitioner</field>
            <field name="category_id" ref="hms.module_category_hms"/>
            <field name="implied_ids" eval="[(4, ref('hms.group_hms_receptionist'))]"/>
        </record>

        <record id="group_hms_pharmacist" model="res.groups">
            <field name="name">Pharmacist</field>
            <field name="category_id" ref="hms.module_category_hms"/>
            <field name="implied_ids" eval="[(4, ref('hms.group_hms_receptionist')), (4, ref('stock.group_stock_user'))]"/>
        </record>

        <record id="group_hms_billing" model="res.groups">
            <field name="name">Billing</field>
            <field name="category_id" ref="hms.module_category_hms"/>
            <field name="implied_ids" eval="[(4, ref('hms.group_hms_receptionist')), (4, ref('account.group_account_invoice'))]"/>
        </record>

        <record id="group_hms_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="hms.module_category_hms"/>
            <field name="implied_ids" eval="[(4, ref('hms.group_hms_practitioner')), (4, ref('hms.group_hms_pharmacist')), (4, ref('hms.group_hms_billing'))]"/>
        </record>

        <!-- Practitioners only see appointments/encounters/prescriptions assigned to them -->
        <record id="rule_appointment_own" model="ir.rule">
            <field name="name">Practitioner: own appointments</field>
            <field name="model_id" ref="model_hms_appointment"/>
            <field name="groups" eval="[(4, ref('hms.group_hms_practitioner'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_encounter_own" model="ir.rule">
            <field name="name">Practitioner: own encounters</field>
            <field name="model_id" ref="model_hms_encounter"/>
            <field name="groups" eval="[(4, ref('hms.group_hms_practitioner'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_prescription_own" model="ir.rule">
            <field name="name">Practitioner: own prescriptions</field>
            <field name="model_id" ref="model_hms_prescription"/>
            <field name="groups" eval="[(4, ref('hms.group_hms_practitioner'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
