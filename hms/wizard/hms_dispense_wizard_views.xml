<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hms_dispense_wizard_form" model="ir.ui.view">
        <field name="name">hms.dispense.wizard.form</field>
        <field name="model">hms.dispense.wizard</field>
        <field name="arch" type="xml">
            <form string="Dispense prescription">
                <group>
                    <field name="prescription_id"/>
                    <field name="location_id"/>
                    <field name="partner_id"/>
                </group>
                <separator string="Medications to dispense"/>
                <field name="line_ids" nolabel="1" readonly="1">
                    <list>
                        <field name="product_id"/>
                        <field name="dose"/>
                        <field name="frequency"/>
                        <field name="duration_days"/>
                        <field name="quantity"/>
                        <field name="uom_id"/>
                    </list>
                </field>
                <footer>
                    <button name="action_dispense" type="object" string="Dispense"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
