<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Pharmacy stock location (child of the default warehouse stock) -->
        <record id="stock_location_pharmacy" model="stock.location">
            <field name="name">Pharmacy</field>
            <field name="usage">internal</field>
            <field name="location_id" ref="stock.stock_location_stock"/>
        </record>

        <!-- Service product used on encounter invoices -->
        <record id="product_consultation" model="product.template">
            <field name="name">Medical Consultation</field>
            <field name="type">service</field>
            <field name="sale_ok" eval="True"/>
            <field name="list_price">0.0</field>
            <field name="invoice_policy">order</field>
        </record>

    </data>
</odoo>
