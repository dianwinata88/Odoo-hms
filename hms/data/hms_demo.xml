<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Departments -->
        <record id="demo_department_general" model="hms.department">
            <field name="name">General Medicine</field>
            <field name="code">GEN</field>
            <field name="description">Primary care and general internal medicine.</field>
        </record>
        <record id="demo_department_cardiology" model="hms.department">
            <field name="name">Cardiology</field>
            <field name="code">CARD</field>
            <field name="description">Heart and cardiovascular care.</field>
        </record>
        <record id="demo_department_pediatrics" model="hms.department">
            <field name="name">Pediatrics</field>
            <field name="code">PED</field>
            <field name="description">Care for infants, children and adolescents.</field>
        </record>

        <!-- Employees backing the practitioners -->
        <record id="demo_employee_hart" model="hr.employee">
            <field name="name">Amelia Hart</field>
            <field name="job_title">Cardiologist</field>
        </record>
        <record id="demo_employee_okafor" model="hr.employee">
            <field name="name">Chidi Okafor</field>
            <field name="job_title">General Practitioner</field>
        </record>
        <record id="demo_employee_reyes" model="hr.employee">
            <field name="name">Lucia Reyes</field>
            <field name="job_title">Pediatric Nurse</field>
        </record>

        <!-- Practitioners -->
        <record id="demo_practitioner_hart" model="hms.practitioner">
            <field name="name">Dr. Amelia Hart</field>
            <field name="employee_id" ref="demo_employee_hart"/>
            <field name="department_id" ref="demo_department_cardiology"/>
            <field name="role">doctor</field>
            <field name="specialization">Interventional Cardiology</field>
            <field name="license_number">MD-2014-0091</field>
            <field name="consultation_fee">150.0</field>
        </record>
        <record id="demo_practitioner_okafor" model="hms.practitioner">
