            <field name="role">doctor</field>
            <field name="specialization">Family Medicine</field>
            <field name="license_number">MD-2017-0342</field>
            <field name="consultation_fee">80.0</field>
        </record>
        <record id="demo_practitioner_reyes" model="hms.practitioner">
            <field name="name">Lucia Reyes, RN</field>
            <field name="employee_id" ref="demo_employee_reyes"/>
            <field name="department_id" ref="demo_department_pediatrics"/>
            <field name="role">nurse</field>
            <field name="license_number">RN-2020-1188</field>
        </record>

