<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hms_diagnosis_form" model="ir.ui.view">
        <field name="name">hms.diagnosis.form</field>
        <field name="model">hms.diagnosis</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Essential hypertension"/></h1>
                        <field name="code" placeholder="I10"/>
                    </div>
                    <group>
                        <field name="active" invisible="1"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hms_diagnosis_list" model="ir.ui.view">
        <field name="name">hms.diagnosis.list</field>
        <field name="model">hms.diagnosis</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_hms_diagnosis_search" model="ir.ui.view">
        <field name="name">hms.diagnosis.search</field>
        <field name="model">hms.diagnosis</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <record id="action_hms_diagnosis" model="ir.actions.act_window">
        <field name="name">Diagnoses</field>
        <field name="res_model">hms.diagnosis</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hms_diagnosis_search"/>
    </record>

    <menuitem id="menu_hms_diagnosis" name="Diagnoses" parent="menu_hms_config"
              action="action_hms_diagnosis" sequence="30"/>
</odoo>
