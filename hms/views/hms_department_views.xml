<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hms_department_form" model="ir.ui.view">
        <field name="name">hms.department.form</field>
        <field name="model">hms.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Cardiology"/></h1>
                        <field name="code" placeholder="CODE"/>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Practitioners">
                            <field name="practitioner_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="role"/>
                                    <field name="specialization"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hms_department_list" model="ir.ui.view">
        <field name="name">hms.department.list</field>
        <field name="model">hms.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="action_hms_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">hms.department</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hms_department" name="Departments" parent="menu_hms_config"
              action="action_hms_department" sequence="10"/>
</odoo>
